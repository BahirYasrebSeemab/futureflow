<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes, plus the little content the guard needs (ADR 0019): the root package of each
     visible app window (picture-in-picture, split screen) and a few browsers' address bars. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
  android:canRetrieveWindowContent="true"
  android:description="@string/guard_service_description"
  android:notificationTimeout="300" />
