{
  "name": "@futureflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply futureflow --local",
    "migrate:remote": "wrangler d1 migrations apply futureflow --remote",
    "deploy": "wrangler deploy",
    "judge:eval": "bun eval/run.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@futureflow/ai": "workspace:*",
    "@futureflow/contracts": "workspace:*",
    "@futureflow/core": "workspace:*",
    "@futureflow/math-engine": "workspace:*",
    "hono": "^4.13.13",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@vitest/coverage-istanbul": "^5.0.3",
    "typescript": "^6",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
