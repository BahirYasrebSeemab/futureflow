{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "futureflow-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Hourly verification and half-hourly upkeep (2 of the 5 free cron triggers).
  "triggers": { "crons": ["0 * * * *", "30 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "futureflow",
      // Replace with the id printed by `bun x wrangler d1 create futureflow` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
  ],
}
